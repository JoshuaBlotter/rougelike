#!/bin/sh
# Auto-stamp APP_VERSION in roguelike.html.
#
# Runs on every commit that includes roguelike.html: bumps the "build N"
# number by one and sets the date to today, so the version tag in the help
# panel always reflects the latest deploy without anyone maintaining it.
#
# If the APP_VERSION line was already edited in this commit (a manual bump),
# the hook leaves it alone — so it never double-bumps and manual overrides win.
file="roguelike.html"

# Only act when roguelike.html is part of this commit.
git diff --cached --name-only | grep -qx "$file" || exit 0

# Respect a manual edit to the version line.
if git diff --cached -U0 -- "$file" | grep -qE '^[+-].*APP_VERSION'; then
  exit 0
fi

cur=$(grep -oE 'build [0-9]+' "$file" | head -1 | grep -oE '[0-9]+')
[ -z "$cur" ] && exit 0
next=$((cur + 1))
today=$(date +%Y-%m-%d)

sed -i -E "s|const APP_VERSION = \"[^\"]*\";|const APP_VERSION = \"build ${next} \xc2\xb7 ${today}\";|" "$file"
git add "$file"
